---
interface Props {
    eyebrow?: string;
    title: string;
    description: string;
    icon?: string;
}

const {
    title,
    description
} = Astro.props;
---

<header class="corporate-page-header">
    <div class="corporate-page-header__copy">
        <h1>{title}</h1>
        <p>{description}</p>
    </div>
    <div class="corporate-page-header__actions">
        <slot name="actions" />
    </div>
</header>
