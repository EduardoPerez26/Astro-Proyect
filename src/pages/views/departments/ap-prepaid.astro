---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
---

<DashboardLayout title="Prepaid Bills | XBFS Operations Hub">
    <main class="prepaid-page property-management-page">
        <section class="prepaid-hero">
            <div>
                <h1>Prepaid Bills</h1>
                <p>
                    Import paid PTAX bill rows from the 246000 GL report, generate the monthly amortization schedule,
                    then upload each monthly GL to validate expected amounts against actual postings.
                </p>
            </div>

            <div class="prepaid-actions">
                <a class="btn-secondary property-window-link" href="/views/departments/ap">
                    <i class="fa-solid fa-table-list" aria-hidden="true"></i>
                    Schedule
                </a>
                <a class="btn-secondary property-window-link" href="/views/departments/ap-documents">
                    <i class="fa-solid fa-folder-tree" aria-hidden="true"></i>
                    Documents
                </a>
                
            </div>
        </section>

        <section class="prepaid-kpis" aria-label="Prepaid schedule summary">
            <article class="prepaid-kpi-card">
                <span>Source rows</span>
                <strong id="kpiSourceRows">0</strong>
                <small>Rows extracted from the bill GL source</small>
            </article>
            <article class="prepaid-kpi-card">
                <span>Included bills</span>
                <strong id="kpiIncludedRows">0</strong>
                <small>Rows used to build the schedule</small>
            </article>
            <article class="prepaid-kpi-card">
                <span>Expected amortization</span>
                <strong id="kpiExpected">$0.00</strong>
                <small>Generated from the included bill rows</small>
            </article>
            <article class="prepaid-kpi-card warning">
                <span>GL difference</span>
                <strong id="kpiDifference">$0.00</strong>
                <small>Actual GL minus expected amortization</small>
            </article>
        </section>

        <div class="prepaid-upload-grid">
            <section class="prepaid-panel prepaid-upload-panel">
            <div class="panel-header stackable">
                <div>
                    <h2>Upload paid bill source</h2>
                    <p>
                        The system reads the paid bill rows and uses the
                        amortization period to calculate the monthly adjustment schedule.
                    </p>
                </div>
            </div>

            <form id="billSourceUploadForm" class="prepaid-form prepaid-source-form" enctype="multipart/form-data">
                <label class="wide-field file-drop" data-file-drop>
                    <span class="file-drop-heading">
                        <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i>
                        Paid bill GL source
                    </span>
                    
                    <input type="file" name="billSourceFile" accept=".xlsx,.xls,.csv" required />
                    <span class="file-drop-selection">
                        <span class="file-drop-name">No file selected</span>
                        <button type="button" class="file-remove-btn" data-remove-file aria-label="Remove selected file" title="Remove selected file">
                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                        </button>
                    </span>
                </label>
            </form>
        </section>

            <section class="prepaid-panel prepaid-gl-panel">
            <div class="panel-header stackable">
                <div>
                    <h2>Upload monthly GL</h2>
                    <p>After generating the schedule, upload the monthly GL to validate expected vs actual amounts by store.</p>
                </div>
            </div>

            <form id="glUploadForm" class="prepaid-form prepaid-gl-form" enctype="multipart/form-data">
                <input type="hidden" id="glScheduleSelect" name="schedule_id" required />

                <label class="wide-field file-drop" data-file-drop>
                    <span class="file-drop-heading">
                        <i class="fa-solid fa-file-arrow-up" aria-hidden="true"></i>
                        Monthly GL files
                    </span>

                    <input type="file" name="glFile" accept=".xlsx,.xls,.csv" multiple required />
                    <span class="file-drop-selection">
                        <span class="file-drop-name">No file selected</span>
                        <button type="button" class="file-remove-btn" data-remove-file aria-label="Remove selected file" title="Remove selected file">
                            <i class="fa-solid fa-trash" aria-hidden="true"></i>
                        </button>
                    </span>
                </label>
            </form>
            </section>
        </div>

        <section class="prepaid-panel">
            <div class="panel-header stackable">
                <div>
                    <h2 id="selectedScheduleTitle">Schedule Detail</h2>
                    <p id="selectedScheduleSubtitle">Select a schedule to load source rows.</p>
                </div>

                <div class="prepaid-detail-actions source-review-actions">
                    <button type="button" class="btn-secondary" id="exportScheduleBtn" disabled>
                        <i class="fa-solid fa-file-excel" aria-hidden="true"></i>
                        Export Schedule
                    </button>
                    <button type="button" class="btn-secondary hidden" id="addSourceRowBtn" disabled>
                        <i class="fa-solid fa-plus" aria-hidden="true"></i>
                        Add Concept
                    </button>
                    <button type="button" class="btn-secondary hidden" id="appendBillSourceBtn" disabled title="Upload a new payment file and add it to this schedule (e.g. September-December)">
                        <i class="fa-solid fa-file-circle-plus" aria-hidden="true"></i>
                        Add Payments
                    </button>
                    <input type="file" id="appendBillSourceInput" class="hidden" accept=".xlsx,.xls,.csv" />
                    <button type="button" class="btn-primary hidden" id="generateScheduleBtn" disabled>
                        <i class="fa-solid fa-calculator" aria-hidden="true"></i>
                        Generate Schedule
                    </button>
                </div>
            </div>

            <div class="prepaid-tabs" role="tablist">
                <button type="button" class="tab-button active" data-tab="source">Source Rows</button>
                <button type="button" class="tab-button" data-tab="schedule">Generated Schedule</button>
                <button type="button" class="tab-button" data-tab="comparison">GL Validation</button>
                <button type="button" class="tab-button" data-tab="differences">Differences</button>
            </div>

            <div id="sourceTab">
                <div class="source-review-bar">
                    <div>
                        <strong>Review before generating</strong>
                        <span id="sourceReviewStatus">Upload a file to review its records before generating.</span>
                    </div>
                    <div class="source-review-bulk-actions">
                        <button type="button" class="btn-secondary hidden" id="bulkAmortizationBtn" disabled>
                            <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                            <span id="bulkAmortizationBtnLabel">Edit amortization</span>
                        </button>
                        <button type="button" class="btn-secondary hidden" id="bulkAccountsBtn" disabled title="Set the Prepaid GL and Expense GL accounts for the selected rows">
                            <i class="fa-solid fa-building-columns" aria-hidden="true"></i>
                            <span id="bulkAccountsBtnLabel">Edit GL Accounts</span>
                        </button>
                        <button type="button" class="btn-secondary hidden" id="bulkRemoveRowsBtn" disabled title="Remove the selected rows from the schedule">
                            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                            <span id="bulkRemoveRowsBtnLabel">Remove rows</span>
                        </button>
                        <button type="button" class="btn-secondary hidden" id="bulkRemoveStoresBtn" disabled title="Remove every row for the selected stores">
                            <i class="fa-solid fa-store-slash" aria-hidden="true"></i>
                            <span id="bulkRemoveStoresBtnLabel">Remove stores</span>
                        </button>
                    </div>
                </div>

                <div class="prepaid-filter-bar">
                    <input type="search" id="sourceFilterInput" class="prepaid-filter-input" placeholder="Search store, payee, doc, memo..."/>
                    <span class="prepaid-filter-count" id="sourceFilterCount"></span>
                </div>

                <div class="prepaid-table-wrap">
                    <table class="prepaid-table prepaid-source-table">
                        <thead id="sourceTableHead">
                            <tr>
                                <th class="source-sticky-select">
                                    <input type="checkbox" id="selectAllSourceRows" title="Select all rows" />
                                </th>
                                <th class="source-sticky-store" data-sort="store">Store</th>
                                <th class="source-sticky-actions">Actions</th>
                                <th data-sort="payee">Concept / Payee</th>
                                <th data-sort="doc">Doc</th>
                                <th data-sort="date">Date</th>
                                <th data-sort="taxYear">Tax Year</th>
                                <th data-sort="amount">Amount Paid</th>
                                <th data-sort="amortStart">Amortization</th>
                                <th data-sort="memo">Memo</th>
                            </tr>
                        </thead>
                        <tbody id="sourceRows">
                            <tr><td colspan="10" class="empty-cell">No source bills loaded.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

                <div class="hidden" id="scheduleTab">
                 <div class="prepaid-filter-bar">
                    <input type="search" id="scheduleFilterInput" class="prepaid-filter-input" placeholder="Search payee, store, GL account..." />
                    <select id="scheduleEntityFilter" class="prepaid-filter-select">
                        <option value="">All entities</option>
                    </select>
                    <span class="prepaid-filter-count" id="scheduleFilterCount"></span>
                </div>

                <div class="prepaid-table-wrap">
                    <table class="prepaid-table prepaid-schedule-matrix">
                        <thead id="scheduleTableHead">
                            <tr>
                                <th data-sort="payee">Payee</th>
                                <th data-sort="location">Location</th>
                                <th data-sort="entity">Entity</th>
                                <th data-sort="glAcct">GL Acct</th>
                                <th data-sort="expAcct">Exp. To GL Acct</th>
                                <th data-sort="date">Date</th>
                                <th data-sort="amortStart">Amortization Period</th>
                                <th data-sort="amount">Amount Paid</th>
                                <th data-sort="priorBalance">Prior Yr End Balance Forward</th>
                                <th data-sort="monthlyAmount">MO AMORT AMT</th>
                                <th data-sort="month0">January</th>
                                <th data-sort="month1">February</th>
                                <th data-sort="month2">March</th>
                                <th data-sort="month3">April</th>
                                <th data-sort="month4">May</th>
                                <th data-sort="month5">June</th>
                                <th data-sort="month6">July</th>
                                <th data-sort="month7">August</th>
                                <th data-sort="month8">September</th>
                                <th data-sort="month9">October</th>
                                <th data-sort="month10">November</th>
                                <th data-sort="month11">December</th>
                                <th data-sort="ytd">YTD Amortization</th>
                                <th data-sort="endingBalance">Ending Prepaid Balance</th>
                                <th data-sort="storeBalance">Ending Balance per Store</th>
                            </tr>
                        </thead>
                        <tbody id="scheduleRows">
                            <tr><td colspan="25" class="empty-cell">No generated amortization yet.</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="prepaid-table-footer hidden" id="saveScheduleFooter">
                    <button type="button" class="btn-primary" id="saveScheduleBtn" disabled>
                        <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
                        Save Schedule
                    </button>
                </div>
            </div>

            <div class="prepaid-table-wrap hidden" id="comparisonTab">
                <div class="prepaid-filter-bar">
                    <input type="search" id="comparisonFilterInput" class="prepaid-filter-input" placeholder="Search store, payee, doc..." />
                    <select id="comparisonStatusFilter" class="prepaid-filter-select">
                        <option value="">All statuses</option>
                        <option value="MATCHED">Matched</option>
                        <option value="DIFFERENCE">Difference</option>
                        <option value="PENDING_GL">Pending GL</option>
                        <option value="MISSING_GL">Missing GL</option>
                    </select>
                    <span class="prepaid-filter-count" id="comparisonFilterCount"></span>
                </div>
                <table class="prepaid-table">
                    <thead id="comparisonTableHead">
                        <tr>
                            <th data-sort="period">Period</th>
                            <th data-sort="store">Store</th>
                            <th data-sort="payee">Payee</th>
                            <th data-sort="doc">Doc</th>
                            <th data-sort="expected">Expected</th>
                            <th data-sort="glActual">GL Actual</th>
                            <th data-sort="difference">Difference</th>
                            <th data-sort="status">Status</th>
                        </tr>
                    </thead>
                    <tbody id="comparisonRows">
                        <tr><td colspan="8" class="empty-cell">No validation loaded.</td></tr>
                    </tbody>
                </table>
            </div>

            <div class="prepaid-table-wrap hidden" id="differencesTab">
                <div class="prepaid-filter-bar">
                    <input type="search" id="differencesFilterInput" class="prepaid-filter-input" placeholder="Search store, payee, doc..." />
                    <span class="prepaid-filter-count" id="differencesFilterCount"></span>
                </div>
                <table class="prepaid-table">
                    <thead id="differencesTableHead">
                        <tr>
                            <th data-sort="period">Period</th>
                            <th data-sort="store">Store</th>
                            <th data-sort="payee">Payee</th>
                            <th data-sort="doc">Doc</th>
                            <th data-sort="expected">Expected</th>
                            <th data-sort="glActual">GL Actual</th>
                            <th data-sort="difference">Difference</th>
                            <th data-sort="status">Status</th>
                        </tr>
                    </thead>
                    <tbody id="differenceRows">
                        <tr><td colspan="8" class="empty-cell">No differences loaded.</td></tr>
                    </tbody>
                </table>
            </div>
        </section>
    </main>
    <script type="module" src="/js/departments/ap/ap-prepaid.js?v=20260803-freeze-columns-v1"></script>
</DashboardLayout>
