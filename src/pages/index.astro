---
import BaseLayout from "../layouts/BaseLayout.astro";

const currentYear = new Date().getFullYear();
---

<BaseLayout title="Sign in | XBFS Operations Hub">
    <main class="login-screen">
        <div class="login-shell">
            <section class="login-brand-panel" aria-label="System overview">
                <div class="login-brand-center">
                    <img src="/img/logo.png" alt="XB" class="login-logo" />
                    <span class="login-brand-caption">XB Franchise Solutions</span>
                </div>
            </section>

            <section class="login-form-panel">
                <button
                    type="button"
                    class="lang-toggle lang-toggle--login"
                    data-lang-toggle
                    aria-label="Switch to English"
                    title="Switch to English"
                    hidden
                >
                    <i class="fa-solid fa-language" aria-hidden="true"></i>
                    <span data-lang-label>EN</span>
                </button>

                <div class="login-form-wrap">
                    <div class="login-mobile-brand" aria-hidden="true">
                        <img src="/img/logo.png" alt="XB" class="login-logo login-logo--sm" />
                    </div>

                    <div class="login-access-card">
                        <div class="login-header">
                            <h2>Bienvenido de vuelta</h2>
                            <p>Ingresa tus datos para continuar.</p>
                        </div>

                        <form class="login-form" id="loginForm">
                            <div class="login-field">
                                <label for="username">Correo</label>
                                <div class="login-input-wrap">
                                    <input
                                        type="text"
                                        id="username"
                                        name="username"
                                        placeholder="correo o usuario"
                                        autocomplete="username"
                                        required
                                        autofocus
                                    />
                                    <i
                                        class="fa-regular fa-envelope"
                                        aria-hidden="true"></i>
                                </div>
                            </div>

                            <div class="login-field">
                                <label for="password">Contraseña</label>
                                <div class="login-input-wrap">
                                    <input
                                        type="password"
                                        id="password"
                                        name="password"
                                        placeholder="contraseña"
                                        autocomplete="current-password"
                                        required
                                    />
                                    <button
                                        class="login-password-toggle"
                                        id="passwordToggle"
                                        type="button"
                                        aria-label="Mostrar contraseña"
                                        aria-pressed="false"
                                    >
                                        <i
                                            class="fa-regular fa-eye"
                                            aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="login-row-between">
                                <label class="login-check-inline">
                                    <input
                                        type="checkbox"
                                        id="rememberSession"
                                        name="rememberSession"
                                        value="true"
                                    />
                                    <span
                                        class="login-check-box"
                                        aria-hidden="true"
                                    >
                                        <i class="fa-solid fa-check"></i>
                                    </span>
                                    <span>Recordarme 30 días</span>
                                </label>

                                <button
                                    type="button"
                                    class="login-forgot-link"
                                    id="forgotPasswordBtn"
                                >
                                    ¿Olvidaste tu contraseña?
                                </button>
                            </div>

                            <button
                                type="submit"
                                id="loginBtn"
                                class="login-submit"
                            >
                                <span>Iniciar sesión</span>
                            </button>
                        </form>

                        <div class="login-enterprise-access" id="entraLoginBlock" hidden>
                            <div class="login-enterprise-divider"><span>o</span></div>
                            <button type="button" class="login-enterprise-button" id="entraLoginBtn">
                                <i class="fa-brands fa-microsoft" aria-hidden="true"></i>
                                <span>Continuar con Microsoft</span>
                            </button>
                            <small>Usa tu cuenta corporativa y las políticas de Microsoft Entra ID.</small>
                        </div>

                        <div class="login-security-note">
                            <i
                                class="fa-solid fa-shield-halved"
                                aria-hidden="true"></i>
                            <span
                                >Tu acceso queda registrado para auditoría interna.</span
                            >
                        </div>
                    </div>
                </div>

                <p class="login-copyright">
                    &copy; {currentYear} XB Franchise Solutions
                </p>
            </section>
        </div>
    </main>

    <script src="/js/config.js" is:inline></script>
    <script src="/js/login.js?v=20260729-flat-redesign-v1" is:inline></script>
    </BaseLayout>
